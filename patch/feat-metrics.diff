+// poolMetricsRegistry is the metrics registry with the pgx pool gauges added.
+func poolMetricsRegistry(pool *pgxpool.Pool) *prometheus.Registry {
+	reg := middleware.NewMetricsRegistry()
+	gauge := func(name, help string, read func(*pgxpool.Stat) int32) prometheus.Collector {
+		return prometheus.NewGaugeFunc(prometheus.GaugeOpts{Name: name, Help: help},
+			func() float64 { return float64(read(pool.Stat())) })
+	}
+	reg.MustRegister(
+		gauge("db_pool_acquired_conns", "Connections currently checked out of the pgx pool.", (*pgxpool.Stat).AcquiredConns),
+		gauge("db_pool_total_conns", "Connections currently open in the pgx pool.", (*pgxpool.Stat).TotalConns),
+		gauge("db_pool_max_conns", "The pgx pool's connection ceiling.", (*pgxpool.Stat).MaxConns),
+	)
+	return reg
+}
