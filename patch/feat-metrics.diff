diff --git a/internal/middleware/metrics.go b/internal/middleware/metrics.go
new file mode 100644
index 00000000..8e1c74ef
--- /dev/null
+++ b/internal/middleware/metrics.go
@@ -0,0 +1,119 @@
+package middleware
+
+import (
+	"crypto/subtle"
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+	chimw "github.com/go-chi/chi/v5/middleware"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/client_golang/prometheus/collectors"
+	"github.com/prometheus/client_golang/prometheus/promhttp"
+)
+
+// MetricsPath is the Prometheus scrape endpoint. Served by Metrics.Middleware
+// itself, ahead of the logger and the rate limits, and never counted.
+const MetricsPath = "/metrics"
+
+// unmatchedRoute labels requests no route matched: the raw path would give
+// every scanner probe its own series.
+const unmatchedRoute = "unmatched"
+
+// Metrics holds the HTTP collectors on a registry of its own (not the global
+// default), so tests and a second router do not share counters.
+type Metrics struct {
+	reg      *prometheus.Registry
+	token    string
+	requests *prometheus.CounterVec
+	duration *prometheus.HistogramVec
+	inFlight prometheus.Gauge
+}
+
+// NewMetricsRegistry returns a registry with the Go runtime and process
+// collectors already registered.
+func NewMetricsRegistry() *prometheus.Registry {
+	reg := prometheus.NewRegistry()
+	reg.MustRegister(
+		collectors.NewGoCollector(),
+		collectors.NewProcessCollector(collectors.ProcessCollectorOpts{}),
+	)
+	return reg
+}
+
+// NewMetrics registers the HTTP collectors on reg. token, when non-empty, is
+// required as a bearer token on MetricsPath.
+func NewMetrics(reg *prometheus.Registry, token string) *Metrics {
+	m := &Metrics{
+		reg:   reg,
+		token: token,
+		requests: prometheus.NewCounterVec(prometheus.CounterOpts{
+			Name: "http_requests_total",
+			Help: "HTTP requests by method, chi route pattern and status code.",
+		}, []string{"method", "route", "status"}),
+		duration: prometheus.NewHistogramVec(prometheus.HistogramOpts{
+			Name:    "http_request_duration_seconds",
+			Help:    "HTTP request latency by method and chi route pattern (live event stream excluded).",
+			Buckets: []float64{.005, .01, .025, .05, .1, .25, .5, 1, 2.5, 5, 10},
+		}, []string{"method", "route"}),
+		inFlight: prometheus.NewGauge(prometheus.GaugeOpts{
+			Name: "http_requests_in_flight",
+			Help: "HTTP requests being served now (live event stream excluded).",
+		}),
+	}
+	reg.MustRegister(m.requests, m.duration, m.inFlight)
+	return m
+}
+
+// Middleware must be installed on the chi router itself (r.Use), first in the
+// chain: the route pattern lives in chi's RouteContext, which exists only
+// inside the mux, and is complete only after next has run.
+func (m *Metrics) Middleware(next http.Handler) http.Handler {
+	scrape := promhttp.HandlerFor(m.reg, promhttp.HandlerOpts{})
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == MetricsPath {
+			if m.token != "" && !bearerMatches(r, m.token) {
+				writeJSONError(w, http.StatusUnauthorized, "unauthorized")
+				return
+			}
+			scrape.ServeHTTP(w, r)
+			return
+		}
+
+		// The live stream stays open for hours; in the histogram and the
+		// in-flight gauge it would read as an outage of slow requests.
+		streaming := r.URL.Path == EventsPath
+		if !streaming {
+			m.inFlight.Inc()
+			defer m.inFlight.Dec()
+		}
+		start := time.Now()
+		ww := chimw.NewWrapResponseWriter(w, r.ProtoMajor)
+		next.ServeHTTP(ww, r)
+
+		route := unmatchedRoute
+		if rc := chi.RouteContext(r.Context()); rc != nil {
+			if p := rc.RoutePattern(); p != "" {
+				route = p
+			}
+		}
+		status := ww.Status()
+		if status == 0 {
+			status = http.StatusOK
+		}
+		m.requests.WithLabelValues(r.Method, route, strconv.Itoa(status)).Inc()
+		if !streaming {
+			m.duration.WithLabelValues(r.Method, route).Observe(time.Since(start).Seconds())
+		}
+	})
+}
+
+func bearerMatches(r *http.Request, token string) bool {
+	const prefix = "Bearer "
+	h := r.Header.Get("Authorization")
+	if len(h) <= len(prefix) || h[:len(prefix)] != prefix {
+		return false
+	}
+	return subtle.ConstantTimeCompare([]byte(h[len(prefix):]), []byte(token)) == 1
+}
diff --git a/internal/middleware/metrics_test.go b/internal/middleware/metrics_test.go
new file mode 100644
index 00000000..4717574c
--- /dev/null
+++ b/internal/middleware/metrics_test.go
@@ -0,0 +1,143 @@
+package middleware
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/client_golang/prometheus/testutil"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// metricsRouter is a chi router with the metrics middleware first, as
+// router.New installs it.
+func metricsRouter(t *testing.T, token string, routes func(r chi.Router)) (*Metrics, http.Handler) {
+	t.Helper()
+	m := NewMetrics(prometheus.NewRegistry(), token)
+	r := chi.NewRouter()
+	r.Use(m.Middleware)
+	routes(r)
+	return m, r
+}
+
+func serve(h http.Handler, method, path string, hdr ...string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, path, nil)
+	for i := 0; i+1 < len(hdr); i += 2 {
+		req.Header.Set(hdr[i], hdr[i+1])
+	}
+	rr := httptest.NewRecorder()
+	h.ServeHTTP(rr, req)
+	return rr
+}
+
+// The route label is the chi pattern, never the raw path: one series per
+// endpoint, not one per id.
+func TestMetrics_RouteLabel_IsThePatternNotThePath(t *testing.T) {
+	m, h := metricsRouter(t, "", func(r chi.Router) {
+		r.Route("/api", func(r chi.Router) {
+			r.Get("/x/{id}", func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusOK) })
+		})
+	})
+
+	serve(h, http.MethodGet, "/api/x/123")
+	serve(h, http.MethodGet, "/api/x/456")
+
+	assert.Equal(t, 2.0, testutil.ToFloat64(m.requests.WithLabelValues("GET", "/api/x/{id}", "200")),
+		"both ids land on the one pattern series")
+	assert.Equal(t, 1, testutil.CollectAndCount(m.requests), "no per-id series")
+	assert.Equal(t, 1, testutil.CollectAndCount(m.duration), "histogram keyed by the pattern too")
+}
+
+func TestMetrics_StatusLabel_IsTheCodeTheHandlerWrote(t *testing.T) {
+	m, h := metricsRouter(t, "", func(r chi.Router) {
+		r.Post("/boom", func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusInternalServerError) })
+		r.Get("/silent", func(http.ResponseWriter, *http.Request) {}) // never writes: net/http sends 200
+	})
+
+	serve(h, http.MethodPost, "/boom")
+	serve(h, http.MethodGet, "/silent")
+
+	assert.Equal(t, 1.0, testutil.ToFloat64(m.requests.WithLabelValues("POST", "/boom", "500")), "a 500 is counted as 500")
+	assert.Equal(t, 0.0, testutil.ToFloat64(m.requests.WithLabelValues("POST", "/boom", "200")), "not as 200")
+	assert.Equal(t, 1.0, testutil.ToFloat64(m.requests.WithLabelValues("GET", "/silent", "200")),
+		"a handler that writes nothing answered 200, not 0")
+}
+
+func TestMetrics_NoRouteMatched_LabelsUnmatched(t *testing.T) {
+	m, h := metricsRouter(t, "", func(r chi.Router) {
+		r.Get("/known", func(_ http.ResponseWriter, _ *http.Request) {})
+	})
+
+	serve(h, http.MethodGet, "/wp-admin/setup-config.php")
+
+	assert.Equal(t, 1.0, testutil.ToFloat64(m.requests.WithLabelValues("GET", unmatchedRoute, "404")))
+	assert.Equal(t, 1, testutil.CollectAndCount(m.requests), "the scanner's path is not a label")
+}
+
+func TestMetrics_InFlight_CountsWhileServingAndReturnsToZero(t *testing.T) {
+	var during float64
+	var m *Metrics
+	m, h := metricsRouter(t, "", func(r chi.Router) {
+		r.Get("/slow", func(_ http.ResponseWriter, _ *http.Request) { during = testutil.ToFloat64(m.inFlight) })
+		r.Get("/panic", func(http.ResponseWriter, *http.Request) { panic(http.ErrAbortHandler) })
+	})
+
+	serve(h, http.MethodGet, "/slow")
+	assert.Equal(t, 1.0, during, "the request is in flight while its handler runs")
+	assert.Equal(t, 0.0, testutil.ToFloat64(m.inFlight), "and leaves when it is done")
+
+	assert.Panics(t, func() { serve(h, http.MethodGet, "/panic") })
+	assert.Equal(t, 0.0, testutil.ToFloat64(m.inFlight), "an aborted request leaves too")
+}
+
+// The live stream stays open for hours: counted, but kept out of latency and
+// in-flight, where it would read as an outage.
+func TestMetrics_EventStream_CountedButNotTimed(t *testing.T) {
+	var during float64
+	var m *Metrics
+	m, h := metricsRouter(t, "", func(r chi.Router) {
+		r.Get(EventsPath, func(_ http.ResponseWriter, _ *http.Request) { during = testutil.ToFloat64(m.inFlight) })
+	})
+
+	serve(h, http.MethodGet, EventsPath)
+
+	assert.Equal(t, 1.0, testutil.ToFloat64(m.requests.WithLabelValues("GET", EventsPath, "200")))
+	assert.Equal(t, 0, testutil.CollectAndCount(m.duration), "no latency sample for the stream")
+	assert.Equal(t, 0.0, during, "the stream is not an in-flight request")
+}
+
+func TestMetrics_ScrapeEndpoint_ServesExpositionAndIsNotCounted(t *testing.T) {
+	m, h := metricsRouter(t, "", func(r chi.Router) {
+		r.Get("/health", func(http.ResponseWriter, *http.Request) {})
+	})
+	serve(h, http.MethodGet, "/health")
+
+	rr := serve(h, http.MethodGet, MetricsPath)
+
+	require.Equal(t, http.StatusOK, rr.Code)
+	body := rr.Body.String()
+	assert.Contains(t, body, `http_requests_total{method="GET",route="/health",status="200"} 1`)
+	assert.Contains(t, body, "http_requests_in_flight 0")
+	assert.Contains(t, body, `http_request_duration_seconds_bucket{method="GET",route="/health",le="0.005"}`)
+	assert.False(t, strings.Contains(body, `route="/metrics"`), "the scrape does not count itself")
+	assert.Equal(t, 1, testutil.CollectAndCount(m.requests))
+}
+
+func TestMetrics_ScrapeEndpoint_WithToken_RefusesWithoutIt(t *testing.T) {
+	// chi skips the middleware chain of a mux with no routes at all.
+	_, h := metricsRouter(t, "s3cret", func(r chi.Router) { r.Get("/health", func(http.ResponseWriter, *http.Request) {}) })
+
+	assert.Equal(t, http.StatusUnauthorized, serve(h, http.MethodGet, MetricsPath).Code, "no header")
+	assert.Equal(t, http.StatusUnauthorized,
+		serve(h, http.MethodGet, MetricsPath, "Authorization", "Bearer wrong").Code, "wrong token")
+	assert.Equal(t, http.StatusUnauthorized,
+		serve(h, http.MethodGet, MetricsPath, "Authorization", "s3cret").Code, "token without the Bearer scheme")
+	assert.Equal(t, http.StatusUnauthorized,
+		serve(h, http.MethodGet, MetricsPath, "Authorization", "Basic: s3cret").Code, "another 7-char scheme")
+	assert.Equal(t, http.StatusOK,
+		serve(h, http.MethodGet, MetricsPath, "Authorization", "Bearer s3cret").Code, "right token")
+}
