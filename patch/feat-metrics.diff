+++ b/internal/router/metrics_test.go
@@ -0,0 +1,63 @@
+package router_test
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/howallet/howallet/internal/config"
+	"github.com/howallet/howallet/internal/router/routertest"
+)
+
+func metricsConfig(enabled bool) *config.Config {
+	return &config.Config{
+		JWT:      config.JWTConfig{Secret: routertest.Secret, AccessTTL: 15 * time.Minute, RefreshTTL: time.Hour},
+		Frontend: config.FrontendConfig{URL: "http://localhost:3000"},
+		Metrics:  config.MetricsConfig{Enabled: enabled},
+		Env:      "test",
+	}
+}
+
+// Off by default: production without METRICS_ENABLED has no /metrics at all.
+func TestRouter_MetricsDisabled_NoScrapeEndpoint(t *testing.T) {
+	rt := routertest.New(t, routertest.Handlers{Config: metricsConfig(false)})
+
+	rec := rt.Do(http.MethodGet, "/metrics", nil)
+
+	assert.Equal(t, http.StatusNotFound, rec.Code)
+	assert.NotContains(t, rec.Body.String(), "http_requests_total")
+}
+
+func TestRouter_MetricsEnabled_CountsRealRoutesByPattern(t *testing.T) {
+	rt := routertest.New(t, routertest.Handlers{Config: metricsConfig(true)})
+
+	require.Equal(t, http.StatusOK, rt.Do(http.MethodGet, "/health", nil).Code)
+	rt.Do(http.MethodGet, "/no/such/path/42", nil)
+	rec := rt.Do(http.MethodGet, "/metrics", nil)
+
+	require.Equal(t, http.StatusOK, rec.Code)
+	body := rec.Body.String()
+	assert.Contains(t, body, `http_requests_total{method="GET",route="/health",status="200"} 1`)
+	assert.NotContains(t, body, "/no/such/path", "a raw path never becomes a label")
+	assert.Contains(t, body, "go_goroutines", "Go runtime collector is on")
+}
+
+// A scraper polling every few seconds from one address must never be refused
+// by the per-IP limit, nor eat that address's budget.
+func TestRouter_MetricsEndpoint_OutsideTheRateLimit(t *testing.T) {
+	rt := routertest.New(t, routertest.Handlers{Config: metricsConfig(true)})
+
+	for i := range 1300 { // the global limit is 1200/min per address
+		rec := rt.Do(http.MethodGet, "/metrics", nil, routertest.Header("X-Real-IP", "203.0.113.9"))
+		if rec.Code != http.StatusOK {
+			t.Fatalf("scrape %d answered %d: /metrics is behind the rate limit", i+1, rec.Code)
+		}
+	}
+	rec := rt.Do(http.MethodGet, "/health", nil, routertest.Header("X-Real-IP", "203.0.113.9"))
+	assert.Equal(t, http.StatusOK, rec.Code, "scrapes did not spend the address's budget")
+	assert.False(t, strings.Contains(rec.Body.String(), "rate"), "not a refusal body")
+}
