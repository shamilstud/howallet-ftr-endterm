+// Option adjusts router.New without growing its positional list.
+type Option func(*options)
+
+type options struct {
+	metricsRegistry *prometheus.Registry
+}
+
+// WithMetricsRegistry makes the metrics middleware (when cfg.Metrics.Enabled)
+// register on reg, so the caller can add its own collectors (the DB pool).
+func WithMetricsRegistry(reg *prometheus.Registry) Option {
+	return func(o *options) { o.metricsRegistry = reg }
